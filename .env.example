NODE_ENV=production
PORT=3001
APP_ORIGIN=https://training.alliage.global

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_TTL_SECONDS=604800

# E-mail (o modo seguro deve ficar ativo até o teste final ser aprovado)
EMAIL_DRY_RUN=true
EMAIL_FROM=Alliage Trainning <no-reply@seudominio.com>
RESEND_API_KEY=

# IA — endpoint compatível com OpenAI /chat/completions
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Login social. Callbacks:
# https://training.alliage.global/api/auth/oauth/google/callback
# https://training.alliage.global/api/auth/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Ações sensíveis: exclusão definitiva de solicitações e exportação do banco
SUPER_ADMIN_EMAIL=firnando@gmail.com

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo
SCHEDULER_HOUR=8
MAX_UPLOAD_BYTES=10485760
