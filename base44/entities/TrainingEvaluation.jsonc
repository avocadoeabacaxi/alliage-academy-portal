{
  "name": "TrainingEvaluation",
  "type": "object",
  "properties": {
    "training_request_id": {
      "type": "string"
    },
    "request_id_display": {
      "type": "string"
    },
    "educator_name": {
      "type": "string"
    },
    "educator_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "training_date": {
      "type": "string",
      "format": "date"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nps_score": {
      "type": "number"
    },
    "content_rating": {
      "type": "number"
    },
    "educator_rating": {
      "type": "number"
    },
    "overall_rating": {
      "type": "number"
    },
    "general_feedback": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "public_token": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "training_request_id",
    "educator_name",
    "product_name"
  ]
}