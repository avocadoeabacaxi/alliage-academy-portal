{
  "name": "TrainingRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "request_category": {
      "type": "string",
      "enum": [
        "Treinamento / Apoio T\u00e9cnico",
        "Evento"
      ],
      "default": "Treinamento / Apoio T\u00e9cnico"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente An\u00e1lise",
        "Aprovado Etapa 1",
        "Aprovado Etapa 2",
        "Rejeitado",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Pendente An\u00e1lise"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Cr\u00edtica"
      ]
    },
    "requester_name": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "enum": [
        "Brasil",
        "LATAM",
        "USA",
        "ROW"
      ]
    },
    "region_detail": {
      "type": "string"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "Filial Alliage",
        "Distribuidor/Dealer",
        "Outro"
      ]
    },
    "company_type_detail": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": [
        "Comercial",
        "Marketing",
        "P\u00f3s-vendas",
        "Consultor T\u00e9cnico",
        "Engenharia",
        "Gest\u00e3o de Pessoas",
        "Outro"
      ]
    },
    "area_detail": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "Novo treinamento",
        "Reciclagem",
        "Atualiza\u00e7\u00e3o de produto",
        "Treinamento de lan\u00e7amento",
        "T\u00e9cnico avan\u00e7ado",
        "Treinamento cl\u00ednico",
        "Apoio t\u00e9cnico",
        "Consulta de mercado",
        "Licita\u00e7\u00e3o",
        "Modifica\u00e7\u00e3o de produto",
        "Treinamento de integra\u00e7\u00e3o",
        "Outro"
      ]
    },
    "request_type_detail": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Feira / Congresso",
        "Demonstra\u00e7\u00e3o",
        "A\u00e7\u00e3o de marketing",
        "Workshop",
        "Lan\u00e7amento de produto",
        "Treinamento em evento",
        "Reuni\u00e3o comercial",
        "Palestra",
        "Evento Comercial",
        "Outro"
      ]
    },
    "event_type_detail": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "event_description": {
      "type": "object"
    },
    "event_start_date": {
      "type": "string",
      "format": "date"
    },
    "event_end_date": {
      "type": "string",
      "format": "date"
    },
    "expected_visitors": {
      "type": "string",
      "enum": [
        "1-50",
        "51-100",
        "101-300",
        "301-500",
        "500+"
      ]
    },
    "booth_space": {
      "type": "string"
    },
    "event_organizer": {
      "type": "string"
    },
    "event_website": {
      "type": "string"
    },
    "alliage_role": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alliage_role_detail": {
      "type": "string"
    },
    "who_invited": {
      "type": "string"
    },
    "who_invited_detail": {
      "type": "string"
    },
    "strategic_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strategic_objectives_detail": {
      "type": "string"
    },
    "costs_covered_by_requester": {
      "type": "boolean"
    },
    "costs_covered_detail": {
      "type": "string"
    },
    "professionals_needed": {
      "type": "string"
    },
    "professionals_names": {
      "type": "string"
    },
    "professionals_equipment": {
      "type": "string"
    },
    "event_history": {
      "type": "object"
    },
    "additional_notes": {
      "type": "object"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_category": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "description": "Lista de produtos selecionados, cada um com categoria e marca",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "brand_detail": {
            "type": "string"
          }
        }
      }
    },
    "product_obs": {
      "type": "string"
    },
    "training_focus": {
      "type": "object"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participants_count": {
      "type": "string",
      "enum": [
        "1-5",
        "6-10",
        "11-20",
        "20+"
      ]
    },
    "participants_list": {
      "type": "array",
      "description": "Lista de participantes que ser\u00e3o notificados 24h antes do treinamento",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "attendance_mode": {
            "type": "string",
            "enum": [
              "Online",
              "Presencial",
              "H\u00edbrido"
            ]
          }
        }
      }
    },
    "reminder_sent": {
      "type": "boolean",
      "description": "Indica se o lembrete de 24h j\u00e1 foi enviado aos participantes",
      "default": false
    },
    "justification": {
      "type": "object"
    },
    "specific_problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_impacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consequence_60_days": {
      "type": "object"
    },
    "needs_deadline": {
      "type": "boolean"
    },
    "deadline_requested": {
      "type": "string",
      "format": "date"
    },
    "deadline_reason": {
      "type": "object"
    },
    "has_multiplier": {
      "type": "boolean"
    },
    "specialist_name": {
      "type": "string"
    },
    "specialist_role": {
      "type": "string"
    },
    "specialist_email": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "Remoto",
        "Presencial",
        "H\u00edbrido"
      ]
    },
    "guest_participation_mode": {
      "type": "string",
      "enum": [
        "Online",
        "Presencial",
        "H\u00edbrido"
      ],
      "default": "Presencial"
    },
    "online_platform": {
      "type": "string",
      "enum": [
        "Google Meet",
        "Microsoft Teams",
        "Zoom",
        "Outro"
      ]
    },
    "online_access_link": {
      "type": "string"
    },
    "needs_educator_link": {
      "type": "boolean",
      "default": false
    },
    "format_details": {
      "type": "string"
    },
    "location_country": {
      "type": "string"
    },
    "location_city": {
      "type": "string"
    },
    "location_specific": {
      "type": "string"
    },
    "location_postal_code": {
      "type": "string"
    },
    "location_street": {
      "type": "string"
    },
    "location_number": {
      "type": "string"
    },
    "location_complement": {
      "type": "string"
    },
    "location_formatted_address": {
      "type": "string"
    },
    "location_place_id": {
      "type": "string"
    },
    "educator_name": {
      "type": "string"
    },
    "educator_id": {
      "type": "string"
    },
    "educator_analysis": {
      "type": "object"
    },
    "decision_stage1": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovado",
        "Rejeitado"
      ],
      "default": "Pendente"
    },
    "date_stage1": {
      "type": "string",
      "format": "date"
    },
    "manager_analysis": {
      "type": "object"
    },
    "decision_stage2": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aprovado",
        "Rejeitado"
      ],
      "default": "Pendente"
    },
    "date_stage2": {
      "type": "string",
      "format": "date"
    },
    "rejection_reason": {
      "type": "object"
    },
    "training_scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "training_completed_date": {
      "type": "string",
      "format": "date"
    },
    "execution_notes": {
      "type": "object"
    },
    "final_notes": {
      "type": "object"
    },
    "original_language": {
      "type": "string",
      "enum": [
        "pt",
        "en",
        "es"
      ],
      "default": "pt"
    }
  },
  "required": [
    "requester_name",
    "requester_email",
    "region",
    "request_type",
    "product_name"
  ]
}