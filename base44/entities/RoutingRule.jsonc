{
  "name": "RoutingRule",
  "type": "object",
  "properties": {
    "request_type": {
      "type": "string",
      "description": "Tipo de solicita\u00e7\u00e3o do formul\u00e1rio (ex: Apoio t\u00e9cnico), ou 'Evento' para solicita\u00e7\u00f5es de evento"
    },
    "product_category": {
      "type": "string",
      "description": "Categoria de produto do formul\u00e1rio. Vazio ou '*' significa aplicar a todos os produtos deste tipo"
    },
    "recipient_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails que devem receber a notifica\u00e7\u00e3o para esta combina\u00e7\u00e3o"
    }
  },
  "required": [
    "request_type"
  ]
}