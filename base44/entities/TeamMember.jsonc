{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "enum": [
        "Brasil",
        "LATAM",
        "USA",
        "ROW"
      ]
    }
  },
  "required": [
    "owner_user_id",
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}