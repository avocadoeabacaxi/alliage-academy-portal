{
  "name": "SurveyResponse",
  "type": "object",
  "properties": {
    "survey_id": {
      "type": "string"
    },
    "training_request_id": {
      "type": "string"
    },
    "respondent_name": {
      "type": "string"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "language": {
      "type": "string"
    },
    "rating_overall": {
      "type": "number"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "survey_id"
  ]
}