{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "solicitante",
        "educador",
        "gerente_regional"
      ],
      "default": "solicitante"
    },
    "region": {
      "type": "string",
      "enum": [
        "Brasil",
        "LATAM",
        "USA",
        "ROW"
      ]
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the user's profile photo"
    },
    "receive_access_request_emails": {
      "type": "boolean",
      "description": "Receber notifica\u00e7\u00f5es por email sobre novos pedidos de acesso",
      "default": false
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "pt",
        "en",
        "es"
      ],
      "default": "pt",
      "description": "Idioma preferido para a interface e notifica\u00e7\u00f5es por email"
    }
  },
  "required": [
    "role"
  ]
}