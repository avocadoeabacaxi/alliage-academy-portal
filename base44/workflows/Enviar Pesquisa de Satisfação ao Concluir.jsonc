{
  "name": "Enviar Pesquisa de Satisfa\u00e7\u00e3o ao Concluir",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Conclu\\u00eddo\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TrainingRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "enviar_pesquisa_de_satisfa_o_ao_concluir",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendSatisfactionSurvey",
            "args": {
              "training_request_id": "data.id",
              "requester_email": "data.requester_email",
              "requester_name": "data.requester_name",
              "request_id_display": "data.request_id"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendSatisfactionSurvey"
  }
}